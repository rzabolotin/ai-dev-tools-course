# Production Environment Configuration
# Copy this file to .env.production and fill in your values

# Database Configuration (External MySQL)
# Format: mysql+aiomysql://user:password@host:port/database
DATABASE_URL=mysql+aiomysql://username:password@your-mysql-host:3306/code_interview

# Example for Railway MySQL:
# DATABASE_URL=mysql+aiomysql://root:password@containers-us-west-xxx.railway.app:3306/railway

# Example for PlanetScale:
# DATABASE_URL=mysql+aiomysql://user:pass@aws.connect.psdb.cloud/dbname?ssl_ca=/etc/ssl/cert.pem

# FastAPI Configuration
ENVIRONMENT=production

# CORS (if you need to restrict origins in production)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
