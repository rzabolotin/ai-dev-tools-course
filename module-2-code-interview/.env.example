# Development Environment Variables
# Copy this file to .env if needed (docker-compose.yml has defaults)

# Backend Database URL (used by docker-compose)
DATABASE_URL=mysql+aiomysql://root:secret@db:3306/code_interview

# Frontend API endpoints (used by Vite dev server)
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
